rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PPDB Online registrations: Validasi ketat formulir pendaftaran masuk
    match /pendaftar/{docId} {
      allow create: if request.resource.data.no != null 
                    && request.resource.data.nik is string
                    && request.resource.data.nik.size() >= 10
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() >= 2;
      allow read, update, delete: if true;
    }
    // Exam score submissions & CBT records
    match /nilai_ujian/{docId} {
      allow create: if request.resource.data.nik is string;
      allow read, update, delete: if true;
    }
    // General collection fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

